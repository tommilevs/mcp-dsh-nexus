{
  "name": "@tommilevs/dsh-control-mcp-client",
  "version": "0.1.0",
  "description": "Token management settings section for DeepSeek Harness",
  "type": "module",
  "main": "lib/host.js",
  "types": "lib/host.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./client": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 --jsx react-jsx --declaration --outDir lib --rootDir src src/host.ts src/index.ts src/token-section.tsx && node scripts/bundle-client.mjs"
  },
  "dependencies": {
    "@tommilevs/dsh-control-mcp-host": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tommilevs/mcp-dsh-nexus.git"
  },
  "homepage": "https://github.com/tommilevs/mcp-dsh-nexus#readme",
  "bugs": {
    "url": "https://github.com/tommilevs/mcp-dsh-nexus/issues"
  }
}
